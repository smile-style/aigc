# Copy this file to deploy/.env before running docker compose.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-server-ip-or-domain
DJANGO_CSRF_TRUSTED_ORIGINS=http://your-server-ip-or-domain:8080

MYSQL_DATABASE=AIGC_STUDIO
MYSQL_ROOT_PASSWORD=replace-with-root-password
MYSQL_USER=aigc_studio
MYSQL_PASSWORD=replace-with-app-password

LLM_BASE_URL=http://token.wd.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=gpt-5.6-sol
LLM_TIMEOUT_SECONDS=300
LLM_LOG_PATH=/app/logs/llm.log
WORKSPACE_DIR=/app/workspace
IMAGE_MODEL=gpt-image-2
IMAGE_API_PATH=/images/generations
IMAGE_SIZE=1024x1536
IMAGE_TIMEOUT_SECONDS=600
