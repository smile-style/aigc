DJANGO_SECRET_KEY=replace-with-a-stable-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

AIGC_HTTP_PORT=8080
AIGC_IMAGE=registry.cn-hangzhou.aliyuncs.com/docker-registry-cache/aigc-studio:latest
SQLITE_GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=360

# Keep SQLite until existing data has been migrated. Set both values to enable MySQL.
DB_ENGINE=sqlite
COMPOSE_PROFILES=
DB_HOST=aigc-db
DB_PORT=3306
MYSQL_DATABASE=AIGC_STUDIO
MYSQL_USER=aigc_studio
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
TZ=Asia/Shanghai

LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=replace-with-model-name
LLM_TIMEOUT_SECONDS=300

IMAGE_MODEL=replace-with-image-model
IMAGE_API_PATH=/chat/completions
IMAGE_SIZE=1024x1536
IMAGE_TIMEOUT_SECONDS=600

DASHSCOPE_API_KEY=replace-with-dashscope-api-key
GENERATION_WORKER_INTERVAL_SECONDS=2
GENERATION_MAX_CONCURRENCY=1
GENERATION_LEASE_SECONDS=900
VIDEO_WORKER_INTERVAL_SECONDS=5
PUBLISH_WORKER_INTERVAL_SECONDS=3
PUBLISH_MAX_CONCURRENCY=1
PUBLISHING_CREDENTIAL_ENCRYPTION_KEY=

# 抖音开放平台应用配置。回调地址须与应用后台完全一致。
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
DOUYIN_SCOPES=user_info,video.create,video.data
DOUYIN_API_BASE_URL=https://open.douyin.com
# Speech-aligned subtitles and export timeline validation
HF_HOME=/app/workspace/.cache/huggingface
SUBTITLE_ASR_BACKEND=faster_whisper
SUBTITLE_WHISPER_MODEL=small
SUBTITLE_WHISPER_DEVICE=cpu
SUBTITLE_WHISPER_COMPUTE_TYPE=int8
SUBTITLE_LANGUAGE=zh
SUBTITLE_WHISPER_VAD_FILTER=false
SUBTITLE_ASR_PART_MIN_CONFIDENCE=0.55
SUBTITLE_MAX_TIMELINE_DRIFT_MS=1000
SUBTITLE_CUE_BOUNDARY_TOLERANCE_MS=300
