LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-model-name
LLM_TIMEOUT_SECONDS=300
LLM_LOG_PATH=logs/llm.log

# Local development defaults to SQLite. Set DB_ENGINE=mysql to use MySQL.
DB_ENGINE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=AIGC_STUDIO
DB_USER=aigc_studio
DB_PASSWORD=replace-with-password
IMAGE_MODEL=gpt-image-2
IMAGE_API_PATH=/images/generations
IMAGE_SIZE=1024x1536
IMAGE_TIMEOUT_SECONDS=600
